+void LinuxNetLink::_mirrorConnectedRoutes(const char *iface)
+{
+	if (_routeTable == RT_TABLE_MAIN || !iface || !iface[0]) {
+		return;
+	}
+
+	struct ifaddrs *list = (struct ifaddrs *)0;
+	if (getifaddrs(&list) != 0) {
+		return;
+	}
+
+	for (struct ifaddrs *i = list; i; i = i->ifa_next) {
+		if ((!i->ifa_addr) || (!i->ifa_netmask) || (!i->ifa_name)) {
+			continue;
+		}
+		if (strcmp(i->ifa_name, iface) != 0) {
+			continue;
+		}
+
+		const int fam = i->ifa_addr->sa_family;
+		unsigned int bits = 0;
+		InetAddress addr;
+		if (fam == AF_INET) {
+			uint32_t m = ntohl(((const struct sockaddr_in *)i->ifa_netmask)->sin_addr.s_addr);
+			while (m & 0x80000000U) {
+				++bits;
+				m <<= 1;
+			}
+			addr.set(&((const struct sockaddr_in *)i->ifa_addr)->sin_addr, 4, bits);
+		} else if (fam == AF_INET6) {
+			const unsigned char *m = ((const struct sockaddr_in6 *)i->ifa_netmask)->sin6_addr.s6_addr;
+			bool done = false;
+			for (int b = 0; (b < 16) && (!done); ++b) {
+				for (int j = 7; j >= 0; --j) {
+					if (m[b] & (1 << j)) {
+						++bits;
+					} else {
+						done = true;
+						break;
+					}
+				}
+			}
+			addr.set(&((const struct sockaddr_in6 *)i->ifa_addr)->sin6_addr, 16, bits);
+		} else {
+			continue;
+		}
+
+		if (!addr) {
+			continue;
+		}
+
+		const InetAddress connected(addr.network());
+		if (!routeIsSet(connected, InetAddress(), InetAddress(), iface)) {
+			addRoute(connected, InetAddress(), InetAddress(), iface);
+		}
+	}
+
+	freeifaddrs(list);
+}
